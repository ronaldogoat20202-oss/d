{
  "name": "orbit-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A custom desktop launcher for Minecraft Java Edition",
  "author": "Orbit Launcher contributors",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron .",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.0",
    "@xmcl/core": "2.16.2",
    "@xmcl/user": "4.4.2",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "7.29.0"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
